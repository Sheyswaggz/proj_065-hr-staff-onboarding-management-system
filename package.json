{
  "name": "hr-onboarding-system",
  "version": "1.0.0",
  "description": "HR Staff Onboarding Management System - TypeScript, React, Express.js, PostgreSQL",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build:all",
    "build:all": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "test": "npm run test:all",
    "test:all": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:coverage": "npm run test:coverage:frontend && npm run test:coverage:backend",
    "test:coverage:frontend": "npm run test:coverage --workspace=frontend",
    "test:coverage:backend": "npm run test:coverage --workspace=backend",
    "lint": "npm run lint:all",
    "lint:all": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint:fix": "npm run lint:fix:frontend && npm run lint:fix:backend",
    "lint:fix:frontend": "npm run lint:fix --workspace=frontend",
    "lint:fix:backend": "npm run lint:fix --workspace=backend",
    "format": "npm run format:all",
    "format:all": "npm run format:frontend && npm run format:backend",
    "format:frontend": "npm run format --workspace=frontend",
    "format:backend": "npm run format --workspace=backend",
    "format:check": "npm run format:check:frontend && npm run format:check:backend",
    "format:check:frontend": "npm run format:check --workspace=frontend",
    "format:check:backend": "npm run format:check --workspace=backend",
    "start": "npm run start:backend",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=backend",
    "db:migrate:reset": "npm run db:migrate:reset --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "health:check": "npm run health:check:frontend && npm run health:check:backend",
    "health:check:frontend": "curl -f http://localhost:3000 || exit 1",
    "health:check:backend": "curl -f http://localhost:8080/health || exit 1",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "logs": "npm run docker:logs",
    "clean": "npm run clean:frontend && npm run clean:backend && npm run docker:clean",
    "clean:frontend": "npm run clean --workspace=frontend",
    "clean:backend": "npm run clean --workspace=backend",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "typecheck:backend": "npm run typecheck --workspace=backend",
    "audit": "npm audit --workspaces",
    "audit:fix": "npm audit fix --workspaces",
    "prepare": "husky install || true",
    "preinstall": "npx only-allow npm"
  },
  "keywords": [
    "hr",
    "onboarding",
    "employee-management",
    "typescript",
    "react",
    "express",
    "postgresql"
  ],
  "author": "HR Onboarding Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/hr-onboarding-system.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/hr-onboarding-system/issues"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^8.0.3"
  }
}