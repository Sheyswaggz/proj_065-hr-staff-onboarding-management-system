# =============================================================================
# HR ONBOARDING SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file serves as a template for environment variables required by the
# HR Staff Onboarding Management System. Copy this file to .env and update
# with your actual values. Never commit .env to version control.
#
# Usage: cp .env.example .env
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node environment (development, production, test)
# Controls logging verbosity, error handling, and optimization levels
NODE_ENV=development

# Application name for logging and monitoring
APP_NAME=hr-onboarding-system

# Application version (should match package.json)
APP_VERSION=1.0.0

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend server port
# Default: 3000
VITE_PORT=3000

# Frontend host binding
# Use 0.0.0.0 for Docker, localhost for local development
VITE_HOST=localhost

# Backend API base URL
# Used by frontend to make API requests
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Enable frontend development mode features
# Set to false in production
VITE_DEV_MODE=true

# Frontend logging level (debug, info, warn, error)
VITE_LOG_LEVEL=info

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Backend server port
# Default: 8080
PORT=8080

# Backend host binding
# Use 0.0.0.0 for Docker, localhost for local development
HOST=localhost

# API version prefix
API_VERSION=v1

# API rate limiting (requests per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Request body size limit
BODY_LIMIT=10mb

# CORS allowed origins (comma-separated)
# Use * for development, specific origins for production
CORS_ORIGINS=http://localhost:3000

# Backend logging level (debug, info, warn, error)
LOG_LEVEL=info

# Enable structured JSON logging
LOG_FORMAT=json

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
# Development example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_onboarding?schema=public

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# Database connection timeout (milliseconds)
DB_CONNECTION_TIMEOUT=10000

# Database query timeout (milliseconds)
DB_QUERY_TIMEOUT=30000

# Enable database query logging
DB_LOG_QUERIES=true

# Database SSL mode (disable, allow, prefer, require, verify-ca, verify-full)
# Use require or verify-full in production
DB_SSL_MODE=disable

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT secret key for token signing
# CRITICAL: Generate a strong random string (min 32 characters)
# Example generation: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# JWT token expiration time
# Examples: 15m, 1h, 7d, 30d
JWT_EXPIRES_IN=24h

# JWT refresh token expiration
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing rounds (bcrypt)
# Higher = more secure but slower (10-12 recommended)
PASSWORD_HASH_ROUNDS=10

# Session secret for cookie signing
# CRITICAL: Generate a strong random string
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Session expiration time (milliseconds)
SESSION_MAX_AGE=86400000

# Enable secure cookies (HTTPS only)
# Set to true in production
SESSION_SECURE=false

# Cookie same-site policy (strict, lax, none)
SESSION_SAME_SITE=lax

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum file upload size (bytes)
# 10MB = 10485760 bytes
MAX_FILE_SIZE=10485760

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/gif,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# File storage path (relative to backend root)
UPLOAD_PATH=./uploads

# File storage type (local, s3, azure)
STORAGE_TYPE=local

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP server configuration for email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password

# Email sender information
EMAIL_FROM=HR Onboarding <noreply@example.com>
EMAIL_REPLY_TO=hr@example.com

# Enable email notifications
EMAIL_ENABLED=false

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching and sessions)
# =============================================================================

# Redis connection URL
# Format: redis://[user]:[password]@[host]:[port]/[database]
REDIS_URL=redis://localhost:6379/0

# Redis connection timeout (milliseconds)
REDIS_TIMEOUT=5000

# Enable Redis for session storage
REDIS_SESSION_ENABLED=false

# Enable Redis for caching
REDIS_CACHE_ENABLED=false

# Cache TTL (seconds)
CACHE_TTL=3600

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Enable health check endpoint
HEALTH_CHECK_ENABLED=true

# Health check endpoint path
HEALTH_CHECK_PATH=/health

# Enable metrics collection
METRICS_ENABLED=true

# Metrics endpoint path
METRICS_PATH=/metrics

# Enable request tracing
TRACING_ENABLED=true

# Correlation ID header name
CORRELATION_ID_HEADER=X-Correlation-ID

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable document upload feature
FEATURE_DOCUMENT_UPLOAD=true

# Enable email notifications
FEATURE_EMAIL_NOTIFICATIONS=false

# Enable advanced reporting
FEATURE_ADVANCED_REPORTS=false

# Enable audit logging
FEATURE_AUDIT_LOG=true

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# AWS Configuration (if using S3 for file storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=hr-onboarding-documents

# Azure Configuration (if using Azure Blob Storage)
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
AZURE_STORAGE_CONTAINER=hr-documents

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Enable debug mode (verbose logging, stack traces)
DEBUG=false

# Enable API documentation (Swagger/OpenAPI)
API_DOCS_ENABLED=true

# API documentation path
API_DOCS_PATH=/api/docs

# Enable GraphQL playground (if using GraphQL)
GRAPHQL_PLAYGROUND=true

# Enable database seeding on startup
DB_SEED_ON_START=false

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker-specific overrides (used in docker-compose.yml)
# These are typically set in docker-compose.yml and override the above values

# Database host for Docker (service name from docker-compose.yml)
# DOCKER_DB_HOST=postgres

# Redis host for Docker (service name from docker-compose.yml)
# DOCKER_REDIS_HOST=redis

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================

# CI environment indicator
CI=false

# Test database URL (used in CI/CD pipelines)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_onboarding_test?schema=public

# Test coverage threshold (percentage)
TEST_COVERAGE_THRESHOLD=90

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# In production, override these values with secure, environment-specific settings:
#
# - NODE_ENV=production
# - JWT_SECRET=<strong-random-secret>
# - SESSION_SECRET=<strong-random-secret>
# - DATABASE_URL=<production-database-url>
# - DB_SSL_MODE=require
# - SESSION_SECURE=true
# - CORS_ORIGINS=https://your-production-domain.com
# - LOG_LEVEL=warn
# - DEBUG=false
# - API_DOCS_ENABLED=false
# =============================================================================